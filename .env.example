# Required: dedicated Sign in with Vercel app.
# Register APP_URL/api/auth/callback as the exact callback URL.
# Scopes: openid profile email offline_access.
# Permissions: AI Gateway Use and Team Read Only.
APP_URL=http://localhost:3000
VERCEL_OAUTH_CLIENT_ID=
VERCEL_OAUTH_CLIENT_SECRET=

# Required: a random session encryption password, at least 32 characters.
# Example generator: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# Required: Neon Postgres for accounts, chat ownership, turn history and design
# revisions. Use a dev branch locally, never the production branch.
DATABASE_URL=

# Required: Upstash Redis for transcripts, HTML artifacts, queued prompts,
# checkpoints, worker leases, and encrypted refresh coordination.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: Redis key prefix (default fx0:v1) and default model. Set a local
# prefix (for example fx0:local) so local chats never mix with production.
# FX0_REDIS_PREFIX=fx0:local
# FX0_MODEL=anthropic/claude-opus-5.5-fast

# Optional: five sponsored Opus 5.5 Fast prompts per IP, protected by BotID.
# Disabled by default. Set both before building/deploying, and run migrations.
# The key stays server-side and is used only for explicit trial admissions.
# After the trial, generation uses the signed-in user's own OAuth team.
# FX0_FREE_PROMPTS=1
# AI_GATEWAY_API_KEY=

# ---------------------------------------------------------------------------
# f0 (phase 2). With the Clerk keys set, Clerk replaces Sign in with Vercel and
# the VERCEL_OAUTH_* variables above are no longer used.
# ---------------------------------------------------------------------------

# Required: Clerk (dashboard.clerk.com → API keys).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Required with Clerk: every signed-in model turn runs on this server key
# (Vercel → AI Gateway → API keys). Also funds the optional guest trial above.
# AI_GATEWAY_API_KEY=

# Optional: model and limits per plan. F0_FREE_MODEL pins free-plan turns
# (default anthropic/claude-opus-5.5-fast — pick something cheaper). Pro turns
# use the model picked in the chat.
# F0_FREE_MODEL=
# F0_FREE_DAILY_PROMPTS=10
# F0_PRO_DAILY_PROMPTS=200
# F0_FREE_SITES=1
# F0_PRO_SITES=20
# Development only: treat every account as Pro.
# F0_ALL_PRO=1

# Required for the paywall: RevenueCat (app.revenuecat.com).
# Web Billing public API key (Project → Apps → your Web Billing app), used by purchases-js.
NEXT_PUBLIC_REVENUECAT_WEB_BILLING_API_KEY=
# Optional: the offering to sell; defaults to the project's current offering.
# NEXT_PUBLIC_REVENUECAT_OFFERING_ID=
# Server: a v2 secret API key with customer_information:customers:read, the project
# id (proj…), and the id (entl…) of the `pro` entitlement.
REVENUECAT_SECRET_API_KEY=
REVENUECAT_PROJECT_ID=
REVENUECAT_PRO_ENTITLEMENT_ID=
# The exact Authorization header value set on the RevenueCat webhook
# (APP_URL/api/webhooks/revenuecat). Generate a long random string.
REVENUECAT_WEBHOOK_AUTH=

# Required for subdomains: a domain separate from the app's, with a wildcard
# (*.SITES_ROOT_DOMAIN) attached to this Vercel project. Sites serve at
# https://<slug>.SITES_ROOT_DOMAIN; without it they serve at APP_URL/s/<slug>.
SITES_ROOT_DOMAIN=

# Required for custom domains (Pro): a Vercel access token that can manage this
# project's domains, the project id (prj_…), and the team id if the project is
# owned by a team.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
# VERCEL_TEAM_ID=
